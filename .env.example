# Copy to backend/.env (or export) and fill in the required secrets.
SPM_ENV=local
SPM_DATABASE_URL=postgresql+asyncpg://spm:spm@localhost:5433/spm
SPM_DB_POOL_SIZE=5
SPM_REDIS_URL=redis://localhost:6380/0
SPM_EVENT_BUS=redis
SPM_NOTIFIER=console
SPM_METRICS=log
# Required. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SPM_JWT_SECRET=change-me
SPM_JWT_TTL_D=90
# Required.
SPM_ADMIN_API_KEY=change-me
# Required.
SPM_IP_HASH_SALT=change-me
SPM_CURRENCY=BDT
SPM_DEFAULT_AREA=demo-central
SPM_CORS_ORIGINS=http://localhost:5173
SPM_SMTP_HOST=localhost
SPM_SMTP_PORT=1025
SPM_SMTP_FROM=alerts@spm.local
SPM_VAPID_PUBLIC_KEY=
SPM_VAPID_PRIVATE_KEY=
SPM_VAPID_SUBJECT=
# Admin backfill (simulator) on AWS; always allowed in local/test.
SPM_ALLOW_BACKFILL=false
SPM_AWS_EVENT_BUS_NAME=spm-bus
SPM_SNS_TOPIC_ARN=
